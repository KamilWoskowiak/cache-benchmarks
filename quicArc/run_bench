#!/usr/bin/env bash

set -euo pipefail

OUTPUT="results.csv"

THREADS=8
OPS=1000000
CACHE_SIZE=10000
DISTRIBUTION="z"
THETA=0.95

# Number of times to repeat each configuration.
REPEATS=5

# Working-set sizes to test.
TOTAL_KEYS=(
  10000
  12500
  15000
  20000
  30000
  50000
  75000
)

# Mapping sleep durations, in microseconds.
MAPPING_SLEEP_US=(
  0
  1
  10
  100
)

echo "Building release binary..."
cargo build --release

# CSV header
echo "repeat,ops_per_thread,threads,cache_size,total_keys,distribution,lambda,theta,warmup,mapping_sleep_us,mapping_spin_us,secs,mops,ns_per_op,warmup_misses" >"$OUTPUT"

for mapping_sleep_us in "${MAPPING_SLEEP_US[@]}"; do
  for total_keys in "${TOTAL_KEYS[@]}"; do
    echo
    echo "========================================"
    echo "mapping_sleep_us=$mapping_sleep_us"
    echo "total_keys=$total_keys"
    echo "cache_size=$CACHE_SIZE"
    echo "========================================"

    for ((repeat = 1; repeat <= REPEATS; repeat++)); do
      echo "  run $repeat/$REPEATS"

      # Prefix the benchmark's CSV output with the repeat number.
      printf "%s," "$repeat" >>"$OUTPUT"

      cargo run \
        --release \
        --quiet \
        -- \
        --threads "$THREADS" \
        --ops "$OPS" \
        --cache_size "$CACHE_SIZE" \
        --total_keys "$total_keys" \
        --distribution "$DISTRIBUTION" \
        --theta "$THETA" \
        --mapping_sleep_us "$mapping_sleep_us" \
        --labeled false \
        2>/dev/null >>"$OUTPUT"
    done
  done
done

echo
echo "Done."
echo "Results written to: $OUTPUT"
