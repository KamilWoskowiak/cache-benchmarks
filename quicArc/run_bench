#!/usr/bin/env bash

set -euo pipefail

OUTPUT="results.csv"

THREADS=52

OPS=1000000
CACHE_SIZE=10000
DISTRIBUTION="z"

THETAS=(
  0.95
  0.75
)

REPEATS=2

TOTAL_KEYS=(
  10000
  12500
  15000
  20000
  30000
  50000
  75000
)

MAPPING_SLEEP_US=(
  0
  1
  10
  100
)

echo "Building release binary..."
cargo build --release

echo "repeat,ops_per_thread,threads,cache_size,total_keys,distribution,lambda,theta,warmup,mapping_sleep_us,mapping_spin_us,secs,mops,ns_per_op,warmup_misses" >"$OUTPUT"

for theta in "${THETAS[@]}"; do
  for mapping_sleep_us in "${MAPPING_SLEEP_US[@]}"; do
    for total_keys in "${TOTAL_KEYS[@]}"; do
      echo
      echo "========================================"
      echo "threads=$THREADS"
      echo "mapping_sleep_us=$mapping_sleep_us"
      echo "total_keys=$total_keys"
      echo "cache_size=$CACHE_SIZE"
      echo "distribution=$DISTRIBUTION"
      echo "theta=$theta"
      echo "========================================"

      for ((repeat = 1; repeat <= REPEATS; repeat++)); do
        echo "  run $repeat/$REPEATS"

        result=$(
          cargo run \
            --release \
            --quiet \
            -- \
            --threads "$THREADS" \
            --ops "$OPS" \
            --cache_size "$CACHE_SIZE" \
            --total_keys "$total_keys" \
            --distribution "$DISTRIBUTION" \
            --theta "$theta" \
            --mapping_sleep_us "$mapping_sleep_us" \
            --labeled false \
            2>/dev/null
        )

        row="$repeat,$result"

        echo "$row" | tee -a "$OUTPUT"
      done
    done
  done
done

echo
echo "Done."
echo "Results written to: $OUTPUT"
