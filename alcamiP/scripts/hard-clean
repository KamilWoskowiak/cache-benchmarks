#!/usr/bin/env bash

set -o nounset
set -o errexit
set -o pipefail

this_dir="$(dirname "$(realpath "${0}")")" || exit

source "${this_dir}/.common.rc" || exit

is_configured || exit 2

# to avoid disaster if build_dir is somehow defined incorrectly in .common.rc
build_dir="${root}/build"

if [[ -d "${build_dir}" ]]; then
    rm -rf "${build_dir}"
fi
